@model ECommerceCsvImport.Web.Models.ProductsIndexViewModel
@{
    ViewData["Title"] = "Каталог товаров";
}

<style>
    .catalog-container {
        font-family: 'Segoe UI', sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .filter-panel {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        align-items: flex-end;
        margin-bottom: 30px;
        background: #f9f9f9;
        padding: 15px;
        border-radius: 8px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

        .filter-group label {
            font-size: 12px;
            color: #555;
            margin-bottom: 5px;
        }

        .filter-group input, .filter-group select {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            min-width: 120px;
        }

    .btn-filter {
        padding: 9px 20px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
    }

        .btn-filter:hover {
            background-color: #218838;
        }

    .title-section {
        text-align: center;
        margin-bottom: 40px;
    }

        .title-section h1 {
            font-weight: 300;
            font-size: 36px;
            margin-bottom: 10px;
        }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 25px;
    }

    .product-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.3s;
    }

        .product-card:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .product-img {
        height: 200px;
        background-color: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 14px;
    }

        .product-img img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    .product-info {
        padding: 15px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .product-name {
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 10px;
        color: #333;
        flex-grow: 1;
    }

    .product-meta {
        font-size: 13px;
        color: #777;
        margin-bottom: 5px;
    }

    .product-price {
        font-size: 20px;
        font-weight: bold;
        color: #008a3d;
        margin-top: 15px;
    }
</style>

<div class="catalog-container">
    <form method="get" asp-action="Index" class="filter-panel">
        <div class="filter-group">
            <label>Мин. цена (₽)</label>
            <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="0" />
        </div>
        <div class="filter-group">
            <label>Макс. цена (₽)</label>
            <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="100000" />
        </div>
        <div class="filter-group">
            <label>Категория</label>
            <select name="category">
                <option value="">Все категории</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>Бренд</label>
            <select name="brand">
                <option value="">Все производители</option>
                @foreach (var b in Model.Brands)
                {
                    <option value="@b" selected="@(Model.SelectedBrand == b)">@b</option>
                }
            </select>
        </div>
        <button type="submit" class="btn-filter">Применить</button>
        <a asp-action="Index" style="margin-left: 10px; color: #d9534f; text-decoration: none; padding-bottom: 10px;">Сбросить</a>
    </form>

    <div class="title-section">
        <h1>Наш каталог товаров</h1>
        <p style="color: #777;">Найдено товаров: @Model.TotalCount на сумму @Model.TotalValue.ToString("N0") ₽</p>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div style="text-align: center; padding: 50px; font-size: 18px; color: #777;">
            По вашему запросу ничего не найдено. <br />
            <a asp-action="Import">Импортировать товары</a>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var product in Model.Products)
            {
                <div class="product-card">
                    <div class="product-img">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" onerror="this.style.display='none'; this.parentElement.innerHTML='Нет фото';" />
                        }
                        else
                        {
                            <span>Нет фото</span>
                        }
                    </div>
                    <div class="product-info">
                        <div class="product-name">@product.Name</div>
                        <div class="product-meta">Бренд: @product.Brand</div>
                        <div class="product-meta">Модель: @product.ModelNumber</div>
                        <div class="product-meta">Гарантия: @product.WarrantyMonths мес.</div>
                        <div class="product-price">@product.Price.ToString("N0") ₽</div>
                    </div>
                </div>
            }
        </div>
    }
</div>