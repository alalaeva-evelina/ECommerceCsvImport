@model ECommerceCsvImport.Web.Models.ImportViewModel
@{
    ViewData["Title"] = "Импорт товаров";
}

<h1>Импорт товаров из CSV</h1>

<form method="post" asp-controller="Products" asp-action="Import">
    <div class="form-group mb-3">
        <label for="filePath">Путь к CSV-файлу (например: /csv/sample_products.csv)</label>
        <input type="text" class="form-control" id="filePath" name="filePath" value="@Model.FilePath" />
    </div>
    <button type="submit" class="btn btn-primary">Импортировать товары</button>
</form>

@if (Model.Result != null)
{
    <hr />
    <h2>Результат импорта</h2>
    <table class="table table-bordered" style="max-width: 500px;">
        <tr>
            <th>Всего строк</th>
            <td>@Model.Result.TotalRows</td>
        </tr>
        <tr>
            <th>Успешно импортировано</th>
            <td>@Model.Result.ImportedCount</td>
        </tr>
        <tr>
            <th>Ошибки</th>
            <td>@Model.Result.ErrorCount</td>
        </tr>
    </table>

    @if (Model.Result.Errors.Count > 0)
    {
        <h3>Список ошибок</h3>
        <table class="table table-bordered table-danger">
            <thead>
                <tr>
                    <th>Строка</th>
                    <th>Описание ошибки</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in Model.Result.Errors)
                {
                    <tr>
                        <td>@error.RowNumber</td>
                        <td>@error.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Index" class="btn btn-success mt-3">Перейти к списку товаров</a>
}